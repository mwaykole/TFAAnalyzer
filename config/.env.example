# =================================================================
# TFA Environment Configuration
# Copy this file to .env and fill in your values
# =================================================================

# -----------------------------------------------------------------
# ReportPortal Configuration (Required)
# -----------------------------------------------------------------
RP_URL=https://reportportal.example.com
RP_USERNAME=your-username
RP_PASSWORD=your-password
RP_PROJECT=your-project

# Alternative: Use token-based auth instead of username/password
# RP_TOKEN=your-api-token

# -----------------------------------------------------------------
# LLM Providers (At least one required for LLM features)
# -----------------------------------------------------------------

# Anthropic (Claude) - Recommended for best accuracy
# ANTHROPIC_API_KEY=sk-ant-...

# Groq - Free tier available, good for testing
# GROQ_API_KEY=gsk_...

# Ollama - Local, no API key needed
# Just ensure Ollama is running: ollama serve

# -----------------------------------------------------------------
# GitHub Integration (Optional)
# -----------------------------------------------------------------
# For fetching test source code from private repos
# GITHUB_TOKEN=ghp_...

# -----------------------------------------------------------------
# Notifications (Optional)
# -----------------------------------------------------------------
# Slack webhook for analysis notifications
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...

# Microsoft Teams webhook
# TEAMS_WEBHOOK_URL=https://outlook.office.com/webhook/...

# -----------------------------------------------------------------
# Redis Cache (Optional - for team deployment)
# -----------------------------------------------------------------
# REDIS_URL=redis://localhost:6379

# -----------------------------------------------------------------
# Logging
# -----------------------------------------------------------------
# LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR
